<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>IRRCompanion</AssemblyName>
    <RootNamespace>IRRCompanion</RootNamespace>
    <Version>1.8.2</Version>
    <Product>IRR Companion</Product>
    <Description>AI preset editor, console command builder, hideout upgrade planner, resource maps and story missions for Incursion Red River</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies for net462, so the project builds on machines/CI without the targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\defaults.json" LogicalName="defaults.json" />
    <EmbeddedResource Include="Resources\commands.json" LogicalName="commands.json" />
    <EmbeddedResource Include="Resources\hideout.json" LogicalName="hideout.json" />
    <EmbeddedResource Include="Resources\icons\*.png" LogicalName="icons/%(Filename).png" />
    <EmbeddedResource Include="Resources\maps.json" LogicalName="maps.json" />
    <EmbeddedResource Include="Resources\weapons.json" LogicalName="weapons.json" />
    <EmbeddedResource Include="Resources\traders.json" LogicalName="traders.json" />
    <EmbeddedResource Include="Resources\loot.json" LogicalName="loot.json" />
    <EmbeddedResource Include="Resources\missions.json" LogicalName="missions.json" />
    <EmbeddedResource Include="Resources\maps\*.jpg" LogicalName="maps/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
