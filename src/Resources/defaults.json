 "params": [
  {
   "key": "AIMultiplier",
   "docKey": "aIMultiplier",
   "cat": "AISettings",
   "section": "General",
   "name": "AI Multiplier",
   "desc": "Scales the map's enemy count, including solo. Each extra coop player adds a further share on top.",
   "warn": "Be careful — more enemies can hurt performance. Values over 2.0 are not recommended for normal gameplay.",
   "type": "number",
   "precision": 2,
   "min": 0.5,
   "max": 3
  },
  {
   "key": "Aggressiveness",
   "docKey": "aggressiveness",
   "cat": "AISettings",
   "section": "Behavior",
   "name": "Aggression",
   "desc": "Controls multiple behaviors, such as how long bots wait before searching for enemies, how likely they are to return fire on first contact, and how likely they take aggressive positions when given the opportunity.",
   "warn": "Low values can cause overly passive bots who sit and wait. High values can cause swarming in some situations.",
   "type": "number",
   "precision": 2,
   "min": 0.01,
   "max": 1
  },
  {
   "key": "AIMemoryLength",
   "docKey": "aIMemoryLength",
   "cat": "AISettings",
   "section": "Behavior",
   "name": "AI Memory Length",
   "desc": "How long after a bot searches your last known location before it returns to a peaceful state and de-aggros. Bots that are not allowed to search for you de-aggro this long after they last sensed you.",
   "warn": "",
   "type": "number",
   "precision": 0,
   "min": 60,
   "max": 600
  },
  {
   "key": "Coordination_PerceptionShareRadius",
   "docKey": "coordination_PerceptionShareRadius",
   "cat": "AISettings",
   "section": "Behavior",
   "name": "Perception Share Radius",
   "desc": "How far bots automatically share what they perceive with friendly bots. A bot that spots an enemy tells every friendly within this radius.",
   "warn": "",
   "type": "number",
   "precision": 0,
   "uiMin": 0,
   "uiMax": 10000
  },
  {
   "key": "bAISuppressTargets",
   "docKey": "bAISuppressTargets",
   "cat": "AISettings",
   "section": "Behavior",
   "name": "Suppress Targets",
   "desc": "Enable or disable bots suppressing the last known location of their enemy. If disabled, bots only shoot when they can see their enemy.",
   "warn": "",
   "type": "bool",
   "precision": 2
  },
  {
   "key": "bCanThrowGrenades",
   "docKey": "bCanThrowGrenades",
   "cat": "AISettings",
   "section": "Behavior",
   "name": "Throw Grenades",
   "desc": "Lets bots throw the grenades they carry at you.",
   "warn": "",
   "type": "bool",
   "precision": 2
  },
  {
   "key": "GrenadeInaccuracy",
   "docKey": "grenadeInaccuracy",
   "cat": "AISettings",
   "section": "Behavior",
   "name": "Grenade Inaccuracy",
   "desc": "How far a bot's grenade can land from where it aimed, in centimeters per 10 meters of throw distance. 0 lands every throw on target.",
   "warn": "Higher = grenades land further off.",
   "type": "number",
   "precision": 0,
   "uiMin": 0,
   "uiMax": 600,
   "step": 10
  },
  {
   "key": "DamageMap.Boss",
   "docKey": "damageMap.boss",
   "cat": "AISettings",
   "section": "Damage",
   "name": "Boss Damage Multiplier",
   "desc": "Damage multiplier applied to boss hits.",
   "warn": "",
   "type": "number",
   "precision": 2,
   "uiMin": 0,
   "uiMax": 3
  },
  {
   "key": "DamageMap.AI",
   "docKey": "damageMap.aI",
   "cat": "AISettings",
   "section": "Damage",
   "name": "Standard AI Damage Multiplier",
   "desc": "Damage multiplier applied when bots hit other bots.",
   "warn": "",
   "type": "number",
   "precision": 2,
   "uiMin": 0,
   "uiMax": 3
  },
  {
   "key": "DamageMap.Player",
   "docKey": "damageMap.player",
